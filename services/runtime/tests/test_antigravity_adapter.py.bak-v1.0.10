from pathlib import Path

import httpx
import pytest

from app.adapters.antigravity import AntigravityAdapter


@pytest.mark.asyncio
async def test_antigravity_parses_json_usage(monkeypatch, tmp_path: Path):
    class FakeResponse:
        def raise_for_status(self):
            return None
        def json(self):
            return {
                "returncode": 0,
                "stderr": "",
                "stdout": '{"status":"SUCCESS","response":"done","usage":{"input_tokens":123,"output_tokens":45,"thinking_tokens":9}}',
                "payload": {
                    "status": "SUCCESS",
                    "response": "done",
                    "usage": {"input_tokens": 123, "output_tokens": 45, "thinking_tokens": 9},
                },
            }

    class FakeClient:
        def __init__(self, *args, **kwargs): pass
        async def __aenter__(self): return self
        async def __aexit__(self, *args): return None
        async def post(self, *args, **kwargs): return FakeResponse()

    monkeypatch.setenv("ANTIGRAVITY_BRIDGE_TOKEN", "secret")
    monkeypatch.setattr(httpx, "AsyncClient", FakeClient)
    run = await AntigravityAdapter("auto").run(workspace=tmp_path, prompt="do it", mode="execute", timeout=30)
    assert run.returncode == 0
    assert run.output == "done"
    assert run.usage["input_tokens"] == 123
    assert run.usage["output_tokens"] == 45


@pytest.mark.asyncio
async def test_antigravity_bridge_unavailable_is_provider_failure(monkeypatch, tmp_path: Path):
    class FakeClient:
        def __init__(self, *args, **kwargs): pass
        async def __aenter__(self): return self
        async def __aexit__(self, *args): return None
        async def post(self, *args, **kwargs):
            raise httpx.ConnectError("no bridge")

    monkeypatch.setenv("ANTIGRAVITY_BRIDGE_TOKEN", "secret")
    monkeypatch.setattr(httpx, "AsyncClient", FakeClient)
    run = await AntigravityAdapter("auto").run(workspace=tmp_path, prompt="do it", mode="execute", timeout=30)
    assert run.provider_failed
    assert run.failure_kind == "provider_unavailable"

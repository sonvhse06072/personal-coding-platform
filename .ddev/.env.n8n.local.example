# Service-scoped n8n secrets. Copy to .ddev/.env.n8n.local and keep it out of Git.
# Existing installs should preserve their current N8N_ENCRYPTION_KEY when migrating.
RUNTIME_API_TOKEN=CHANGE_ME
N8N_ENCRYPTION_KEY=CHANGE_ME
N8N_CONTROL_PLANE_TOKEN=CHANGE_ME
# Optional until Telegram notifications/owner controls are enabled locally. Set
# all three Telegram values together. TELEGRAM_OWNER_USER_ID is the numeric
# Telegram user id allowed to execute one-time Runtime control actions.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OWNER_USER_ID=

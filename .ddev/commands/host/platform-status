#!/usr/bin/env bash
## Description: Show health of the personal coding platform services
## Usage: platform-status
set -euo pipefail
printf "%-18s %s\n" "router" "$(ddev exec -s router curl -fsS http://127.0.0.1:8090/health 2>/dev/null || echo DOWN)"
printf "%-18s %s\n" "coding-runtime" "$(ddev exec -s coding-runtime curl -fsS http://127.0.0.1:8787/health 2>/dev/null || echo DOWN)"
printf "%-18s %s\n" "ddev-executor" "$(ddev exec -s ddev-executor curl -fsS http://127.0.0.1:8790/health 2>/dev/null || echo DOWN)"
printf "%-18s %s\n" "n8n" "$(ddev exec -s n8n node -e 'fetch("http://127.0.0.1:5678/healthz").then(async r=>{if(!r.ok)process.exit(1);console.log(await r.text())}).catch(()=>process.exit(1))' 2>/dev/null || echo DOWN)"

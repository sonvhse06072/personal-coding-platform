#!/usr/bin/env bash
## Description: Run Router, Coding Runtime and DDEV executor unit tests
## Usage: platform-test
set -euo pipefail

ddev exec -s router sh -lc 'PYTHONPATH=/app pytest -q /app/tests'
ddev exec -s coding-runtime sh -c 'PYTHONPATH=/app /opt/venv/bin/python -m pytest -q /app/tests'
ddev exec -s ddev-executor sh -lc 'PYTHONPATH=/app pytest -q /app/tests'

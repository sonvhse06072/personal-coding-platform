#!/usr/bin/env bash
## Description: Run Router, Coding Runtime and DDEV executor unit tests
## Usage: platform-test
set -euo pipefail

bash ./scripts/with-host-secrets.sh ./scripts/antigravity-bridge.sh status >/dev/null

expected_codex="$(awk -F= '$1 == "CODEX_VERSION" {print $2; exit}' ./config/tool-versions.env)"
[[ -n "$expected_codex" ]] || {
  echo "Missing pinned CODEX_VERSION" >&2
  exit 20
}
actual_codex="$(ddev exec -s coding-runtime codex --version 2>/dev/null || true)"
if [[ "$actual_codex" != "codex-cli $expected_codex" ]]; then
  echo "Codex CLI version mismatch: expected codex-cli $expected_codex, got ${actual_codex:-DOWN}" >&2
  exit 20
fi

# Router and executor install test dependencies globally.
ddev exec -s router sh -c 'PYTHONPATH=/app pytest -q /app/tests'

# Coding Runtime uses an isolated venv. Use its absolute interpreter path so
# login-shell PATH changes cannot hide pytest.
ddev exec -s coding-runtime sh -c 'PYTHONPATH=/app /opt/venv/bin/python -m pytest -q -p no:cacheprovider /app/tests'

ddev exec -s ddev-executor sh -c 'PYTHONPATH=/app pytest -q /app/tests'

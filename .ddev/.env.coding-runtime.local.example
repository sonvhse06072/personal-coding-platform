# Service-scoped Coding Runtime credentials. Copy to .ddev/.env.coding-runtime.local and keep it out of Git.
ROUTER_API_TOKEN=CHANGE_ME
RUNTIME_API_TOKEN=CHANGE_ME
PLATFORM_INTERNAL_TOKEN=CHANGE_ME
ANTIGRAVITY_BRIDGE_TOKEN=CHANGE_ME

# Read-only browser dashboard credential. This token cannot call Runtime mutation APIs.
DASHBOARD_READ_TOKEN=CHANGE_ME

# Telegram control identity only. Runtime never receives TELEGRAM_BOT_TOKEN.
# Keep these values identical to the n8n Telegram owner configuration.
TELEGRAM_CHAT_ID=
TELEGRAM_OWNER_USER_ID=

# Optional API-backed providers belong only to Coding Runtime.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

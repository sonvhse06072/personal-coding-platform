# Local-only platform environment template. bootstrap.sh copies this file to .ddev/.env
# and replaces CHANGE_ME values/secrets on first setup.

HOST_HOME=/home/CHANGE_ME
CODING_PROJECTS_ROOT=/home/CHANGE_ME/projects
CODING_WORKSPACES_ROOT=/home/CHANGE_ME/.coding-platform/workspaces
DOCKER_GID=999

ROUTER_API_TOKEN=CHANGE_ME
RUNTIME_API_TOKEN=CHANGE_ME
PLATFORM_INTERNAL_TOKEN=CHANGE_ME
N8N_ENCRYPTION_KEY=CHANGE_ME
ANTIGRAVITY_BRIDGE_TOKEN=CHANGE_ME
ANTIGRAVITY_BRIDGE_PORT=8792

# Dedicated credential used only by ddev-executor for GitHub branch/PR delivery.
# Keep this out of coding-runtime so coding agents cannot inherit it.
GITHUB_DELIVERY_TOKEN=

# Subscription / agent CLI versions. Pin these locally when you want fully reproducible builds.
CODEX_VERSION=latest
OPENCODE_VERSION=latest
DDEV_EXECUTOR_VERSION=v1.25.4
DDEV_EXECUTOR_BUILDX_VERSION=v0.37.0
N8N_IMAGE=n8nio/n8n:latest

# Optional API-backed providers.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

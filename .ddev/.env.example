# Local-only shared platform environment template. bootstrap.sh copies this file to .ddev/.env.
#
# IMPORTANT: DDEV injects .ddev/.env into every project container, so this file
# must contain only non-secret shared configuration. Credentials live in:
# - .ddev/.env.router.local
# - .ddev/.env.coding-runtime.local
# - .ddev/.env.ddev-executor.local
# - .ddev/.env.n8n.local
# - .ddev/.env.host.local (host helper scripts only)

HOST_HOME=/home/CHANGE_ME
CODING_PROJECTS_ROOT=/home/CHANGE_ME/projects
CODING_WORKSPACES_ROOT=/home/CHANGE_ME/.coding-platform/workspaces
# Exact repo path allowed to use runtime.workspace_mode=direct.
# Keep this narrower than CODING_PROJECTS_ROOT.
CODING_DIRECT_PROJECT_ROOT=/home/CHANGE_ME/chonhac
DOCKER_GID=999
ANTIGRAVITY_BRIDGE_PORT=8792

# Subscription / agent CLI versions. Pin these locally when you want fully reproducible builds.
CODEX_VERSION=latest
OPENCODE_VERSION=latest
DDEV_EXECUTOR_VERSION=v1.25.4
DDEV_EXECUTOR_BUILDX_VERSION=v0.37.0
N8N_IMAGE=n8nio/n8n:2.38.6

# One disposable PCP G1-T01 Runtime. Unlike the legacy Runtime image this
# installs Codex only (no OpenCode); Router/Executor are reused unchanged.
FROM node:22-bookworm-slim

ARG CODEX_VERSION
ARG DDEV_UID=1000
ARG DDEV_GID=1000

RUN test -n "${CODEX_VERSION}" \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
         python3 python3-venv git ca-certificates ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g "@openai/codex@${CODEX_VERSION}"

WORKDIR /app
COPY services/runtime/requirements.txt /app/requirements.txt
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir -r /app/requirements.txt

COPY services/runtime/app /app/app
RUN mkdir -p /home/coder/.cache /home/coder/.config /home/coder/.local \
    && chown -R "${DDEV_UID}:${DDEV_GID}" /home/coder

LABEL org.opencontainers.image.pcp.g1-scope="pcp-t01-runtime-only"
LABEL org.opencontainers.image.pcp.codex-version="${CODEX_VERSION}"

ENV HOME=/home/coder PATH="/opt/venv:${PATH}" PYTHONUNBUFFERED=1
CMD ["/bin/false"]

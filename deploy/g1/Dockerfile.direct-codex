# Dedicated G1-T01 direct-control image. Not PCP Runtime/Router/Executor.
# No OpenCode, no PostgreSQL, no Runtime pip dependencies, no Docker CLI.
FROM node:22-bookworm-slim

ARG CODEX_VERSION
ARG DDEV_UID=1000
ARG DDEV_GID=1000

RUN test -n "${CODEX_VERSION}" \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
         ca-certificates git python3 ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g "@openai/codex@${CODEX_VERSION}"

RUN mkdir -p /home/coder/.cache /home/coder/.config /home/coder/.local \
    && chown -R "${DDEV_UID}:${DDEV_GID}" /home/coder

LABEL org.opencontainers.image.pcp.g1-scope="direct-control-only"
LABEL org.opencontainers.image.pcp.codex-version="${CODEX_VERSION}"

ENV HOME=/home/coder
WORKDIR /pilot/direct-workspace
CMD ["/bin/false"]
